for ($i = 0; $i < count($WAKUPATTERN[$wWakuPattern]['AMPM']); $i++) {
	$WakuName = $WAKUPATTERN[$wWakuPattern]['AMPM'][$i];




	${'wWaku' . $WakuName . 'Col'} = ceil($KokonoWakuSu[$i] / $wHansu);
