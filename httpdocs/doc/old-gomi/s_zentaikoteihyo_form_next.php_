	if (!$myBukken->executeSelect("BukkenCD = ".$editBukkenCD , "")) {
		trigger_error("Getting tFileF Failed.", E_USER_ERROR);
	}

	$BukkenName = $myBukken->BukkenName;

	unset($myBukken);











