			$sheet->getRowDimension('73')->setVisible(false);#行非表示
			$sheet->getRowDimension('74')->setVisible(false);#行非表示
		}else{
			$tmpCell = $sheet->getCell('D72'); #タグ本数を出力
			$tmpCellStr = $tmpCell->getValue();
			$tmpCellStr = str_replace("▲", $wTagSuu, $tmpCellStr);
			$tmpCell->setValue($tmpCellStr);
