		$tmpCellStr = str_replace("KojiName",$KojiName,$tmpCellStr);	
		$tmpCell->setValue($tmpCellStr);								
		$spreadsheet->getActiveSheet()->getStyle('E7')->getFont()->setSize(22);
	}
	

	$tmpCell = $sheet->getCell('B9');	#挨拶文
